# Copy values into your shell or an explicitly loaded env file. The app does not auto-load .env.
TF_ENVIRONMENT=development
TF_DATABASE_URL=sqlite:///./data/tenantforge.db
TF_STORAGE_BACKEND=local
TF_STORAGE_DIR=./data/objects
TF_AUTH_MODE=local
# Development only. Replace before sharing the local server.
TF_JWT_SECRET=local-demo-only-replace-before-sharing-32-bytes
TF_JWT_ISSUER=tenantforge-local
TF_JWT_AUDIENCE=tenantforge-api
TF_EMBEDDING_BACKEND=hash
TF_EMBEDDING_MODEL=hash-v1
TF_EMBEDDING_DIMENSIONS=384
TF_GENERATION_BACKEND=extractive
TF_RERANKER=lexical
# Real semantic embedding + generation example (requires a fresh/reindexed corpus):
# TF_EMBEDDING_BACKEND=openai
# TF_EMBEDDING_MODEL=text-embedding-3-small
# TF_EMBEDDING_DIMENSIONS=384
# TF_GENERATION_BACKEND=openai
# TF_PROVIDER_BASE_URL=https://api.openai.com/v1
# TF_PROVIDER_API_KEY=YOUR_KEY
# TF_LLM_MODEL=YOUR_CHAT_COMPLETIONS_COMPATIBLE_MODEL
# TF_LLM_COMPLEX_MODEL=YOUR_LARGER_CHAT_COMPLETIONS_COMPATIBLE_MODEL
# Optional local neural embedding + cross encoder (pip install '.[semantic]'):
# TF_EMBEDDING_BACKEND=sentence_transformers
# TF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TF_RERANKER=cross_encoder
# TF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Production requires all of these, plus a PostgreSQL non-owner application role:
# TF_ENVIRONMENT=production
# TF_DATABASE_URL=postgresql+psycopg://rag_app:REPLACE@database:5432/tenantforge
# TF_AUTH_MODE=oidc
# TF_JWKS_URL=https://YOUR_ISSUER/.well-known/jwks.json
# TF_JWT_ISSUER=https://YOUR_ISSUER/
# TF_JWT_AUDIENCE=tenantforge-api
# TF_STORAGE_BACKEND=s3
# TF_S3_BUCKET=YOUR_PRIVATE_BUCKET
# TF_METRICS_TOKEN=YOUR_RANDOM_METRICS_TOKEN
# TF_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
